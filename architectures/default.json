{
  "hidden": [
    {
      "units": 64,
      "activation": "sigmoid",
      "initializer": "glorot_uniform"
    },
    {
      "units": 32,
      "activation": "sigmoid",
      "initializer": "glorot_uniform"
    }
  ],
  "output": {
    "activation": "softmax",
    "initializer": "glorot_uniform"
  },
  "loss": "categoricalCrossentropy",
  "optimizer": {
    "name": "rmsprop",
    "learning_rate": 0.0001
  }
}
