{
  "hidden": [
    {
      "units": 16,
      "activation": "leaky_relu",
      "initializer": "heUniform"
    },
    {
      "units": 8,
      "activation": "leaky_relu",
      "initializer": "heUniform"
    }
  ],
  "output": {
    "activation": "softmax",
    "initializer": "heUniform"
  },
  "loss": "categoricalCrossentropy",
  "optimizer": {
    "name": "nesterov",
    "learning_rate": 0.01,
    "hyperparameters": {
      "momentum": 0.9
    }
  }
}
